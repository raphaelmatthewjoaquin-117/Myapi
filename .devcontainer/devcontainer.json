{
  "name": "MyApi Docker Lab",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": true,
      "installDockerCompose": true
    }
  },
  "forwardPorts": [80],
  "portsAttributes": {
    "80": {
      "label": "MyApi via nginx",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "dotnet restore MyApi/MyApi.csproj"
}
